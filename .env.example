# ── Required ────────────────────────────────────────────────────────────────
# These have no defaults in docker-compose.yml — the stack will not start
# correctly without them.

# JWT signing secret shared by auth and gateway (min 32 chars recommended)
JWT_SECRET=change-me-use-a-long-random-string

# Admin user bootstrapped into auth service on first start
ADMIN_PASSWORD=change-me

# Gmail SMTP credentials for notification-service
# Use a Gmail App Password (not your account password):
# https://myaccount.google.com/apppasswords
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# ── Optional (shown with their defaults) ────────────────────────────────────

# Postgres — single shared database, two schemas (auth / ticket)
DB_NAME=ticket_system
DB_USER=ticket_user
DB_PASSWORD=1234
DB_PORT=5432

# Admin username (default: admin)
# ADMIN_USER=admin

# Spring profile: dev | prod
# SPRING_PROFILE=dev

# CORS origins allowed by the gateway (comma-separated)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
