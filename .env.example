# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_password_here

# Auth Service Database
AUTH_DB_NAME=e2d_auth_server

# Ticket Service Database
TICKET_DB_NAME=e2d_ticket_server

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_min_256_bits

# Admin Bootstrap
ADMIN_USER=admin
ADMIN_PASSWORD=your_admin_password_here

# Email Configuration (Notification Service)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Server Ports
AUTH_SERVER_PORT=8081
GATEWAY_PORT=8001
TICKET_SERVER_PORT=8088
NOTIFICATION_SERVER_PORT=9000

# Service URLs (Production)
AUTH_SERVICE_URL=http://auth-service:8081
TICKET_SERVICE_URL=http://ticket-service:8088

# Spring Profile (dev, prod, test)
SPRING_PROFILES_ACTIVE=dev

# Logging Configuration
SQL_LOG_LEVEL=INFO
SQL_PARAM_LOG_LEVEL=INFO
